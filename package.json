{
  "name": "brainwaves-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host localhost",
    "dev:backend": "node scripts/backend.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.mjs vite.config.ts && node scripts/python.mjs -m ruff check backend",
    "test": "vitest run && node scripts/python.mjs -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

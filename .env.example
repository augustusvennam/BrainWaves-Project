# Copy to .env. Never put Emotiv secrets in VITE_ variables.
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=
CORTEX_URL=wss://localhost:6868
# Use the certificate path to enable TLS verification; otherwise only local Cortex is allowed.
CORTEX_CA_CERT=
CORTEX_HEADSET_ID=
CORTEX_STREAMS=com,met,dev,eq,sys
# Add eeg,pow above only if your license allows them.
# Activate for raw EEG/high-resolution metrics; may consume licensed session quota.
CORTEX_ACTIVATE_SESSION=false
CORTEX_REQUEST_TIMEOUT=10
CORTEX_RECONNECT_SECONDS=5
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
# Optional: requires your own Android SDK bridge, not a native Temi HTTP server.
TEMI_BRIDGE_URL=
TEMI_BRIDGE_TOKEN=

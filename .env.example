# Rotate any client secret previously committed to Git before filling this in.
EMOTIV_CLIENT_ID=replace-with-emotiv-client-id
EMOTIV_CLIENT_SECRET=replace-with-emotiv-client-secret
# Optional EMOTIV rootCA.pem path if the OS/Python trust store needs it.
CORTEX_CA_FILE=
# Required when multiple headsets exist; explicitly set a virtual ID only for development.
CORTEX_HEADSET_ID=
TEMI_IP=192.168.1.100
TEMI_ENABLED=0
# Opt in to speaking a new stable estimate; no robot movement is automated.
TEMI_AUTO_SPEAK=0
